:lvlx vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=519 & Rc=0 { vrD = lvlx(RA_OR_ZERO + B); }
:lvrx vrD,RA_OR_ZERO,B is OP=31 & vrD & RA_OR_ZERO & B & XOP_1_10=551 & Rc=0 { vrD = lvrx(RA_OR_ZERO + B); }
:stvlx vrS,RA_OR_ZERO,B is OP=31 & vrS & RA_OR_ZERO & B & XOP_1_10=647 & Rc=0 { stvlx(RA_OR_ZERO + B, vrS); }
:stvrx vrS,RA_OR_ZERO,B is OP=31 & vrS & RA_OR_ZERO & B & XOP_1_10=679 & Rc=0 { stvrx(RA_OR_ZERO + B, vrS); }
