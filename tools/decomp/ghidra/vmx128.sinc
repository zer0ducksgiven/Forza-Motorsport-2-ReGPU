vD128: x_d5_0 is x_d2=0 & x_d5_0 { export x_d5_0; }
vD128: x_d5_1 is x_d2=1 & x_d5_1 { export x_d5_1; }
vD128: x_d5_2 is x_d2=2 & x_d5_2 { export x_d5_2; }
vD128: x_d5_3 is x_d2=3 & x_d5_3 { export x_d5_3; }
vA128: x_a5_0 is x_a1=0 & x_a1h=0 & x_a5_0 { export x_a5_0; }
vA128: x_a5_1 is x_a1=1 & x_a1h=0 & x_a5_1 { export x_a5_1; }
vA128: x_a5_2 is x_a1=0 & x_a1h=1 & x_a5_2 { export x_a5_2; }
vA128: x_a5_3 is x_a1=1 & x_a1h=1 & x_a5_3 { export x_a5_3; }
vB128: x_b5_0 is x_b2=0 & x_b5_0 { export x_b5_0; }
