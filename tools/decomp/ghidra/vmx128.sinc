  x_d2=(2,3)
  x_a1=(5,5) x_a1h=(10,10)
  x_b2=(0,1)
  x_c3=(6,8)
  x_simm=(16,20) signed
  x_uimm=(16,20)
  x_shb=(6,9)
  x_d3d0=(18,24) x_d3d1=(16,17) x_d3d2=(6,7)
  x_perm_lo=(16,20) x_perm_hi=(6,8)
  x_rc=(6,6)
  f0_1=(0,1)
  f4_4=(4,4)
  f4_5=(4,5)
  f4_10=(4,10)
  f6_9=(6,9)
  f8_10=(8,10)
  f9_9=(9,9)
  f9_10=(9,10)
#@end

# 128-register operands: the high bits pick a bank of 32 (v0-v31 are vs32-vs63), the low 5 bits index into it
attach variables [ x_d5_0 x_a5_0 x_b5_0 ] [ vs32 vs33 vs34 vs35 vs36 vs37 vs38 vs39 vs40 vs41 vs42 vs43 vs44 vs45 vs46 vs47 vs48 vs49 vs50 vs51 vs52 vs53 vs54 vs55 vs56 vs57 vs58 vs59 vs60 vs61 vs62 vs63 ];
attach variables [ x_d5_1 x_a5_1 x_b5_1 ] [ v32 v33 v34 v35 v36 v37 v38 v39 v40 v41 v42 v43 v44 v45 v46 v47 v48 v49 v50 v51 v52 v53 v54 v55 v56 v57 v58 v59 v60 v61 v62 v63 ];
attach variables [ x_d5_2 x_a5_2 x_b5_2 ] [ v64 v65 v66 v67 v68 v69 v70 v71 v72 v73 v74 v75 v76 v77 v78 v79 v80 v81 v82 v83 v84 v85 v86 v87 v88 v89 v90 v91 v92 v93 v94 v95 ];
