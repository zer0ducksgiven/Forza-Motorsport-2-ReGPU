# The Xbox 360's CPU (Xenon): Power ISA 64-bit big endian with AltiVec, as Ghidra's ppc_64_isa_altivec_be,
# plus VMX128 (vmx128.sinc, generated by vmx128.py). Installed into Ghidra by install_xenon.py.

@define ENDIAN "big"

@define IS_ISA "1"
@define NoLegacyIntegerMultiplyAccumulate "1"

@define REGISTER_SIZE "8"
@define BIT_64 "64"

@define EATRUNC "ea"

@define CTR_OFFSET "32"

@include "ppc_common_xenon.sinc"
@include "ppc_isa_xenon.sinc"

@include "ppc_a2.sinc"
@include "quicciii.sinc"
@include "FPRC.sinc"

@include "altivec_xenon.sinc"
@include "vmx128.sinc"
